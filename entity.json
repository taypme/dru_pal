{
  "version": 2,
  "name": "Dru",
  "description": "A repository-hydrated command system whose typed entities are organized into buckets.",
  "hydration": {
    "default_branch": "main",
    "branch_syntax": "Dru <repository> on <branch>"
  },
  "aliases": [
    {
      "machine": "pal new",
      "canonical": "pal create",
      "type": "permanent"
    }
  ],
  "storage": {
    "registry_path": "entity.json",
    "state_path": "entity-state.json",
    "root": "entities",
    "bucket_pattern": "entities/{{ type }}/{{ bucket }}",
    "data_pattern": "entities/{{ type }}/{{ bucket }}/data/{{ encoded_name }}.json",
    "entity_pattern": "entities/trello/{{ board }}.json",
    "index_pattern": "entities/{{ type }}/{{ bucket }}/index.json",
    "pack_pattern": "entities/{{ type }}/{{ bucket }}/pack.json",
    "mutation_pattern": "mutations/{{ type }}/{{ bucket }}/{{ uuid }}.json",
    "canonical": "per-row JSON files for row-oriented entities; aggregate arrays for Hoard; one JSON file per Trello board",
    "generated": [
      "index.json",
      "pack.json",
      "entity-state.json"
    ]
  },
  "global_commands": [
    {
      "machine": "dru",
      "semantic": "When the entire user message is exactly Dru after trimming whitespace, output a Markdown table with columns Type, Bucket, and Rows for every registered entity, sorted by normalized bucket name, using entity-state.json counts."
    },
    {
      "machine": "pull",
      "semantic": "Refresh the active repository at one exact commit and validate entity.json against entity-state.json.registry_blob_sha."
    },
    {
      "machine": "behavior",
      "semantic": "Report conversation-only state not recreated by fresh hydration."
    },
    {
      "machine": "mutations",
      "semantic": "Report pending repository-local and conversation-only mutations grouped by action."
    },
    {
      "machine": "add",
      "semantic": "Queue a complete add mutation for the addressed bucket of any entity type."
    },
    {
      "machine": "update",
      "semantic": "Queue an update mutation for the addressed bucket of any entity type."
    },
    {
      "machine": "delete",
      "semantic": "Queue a remove mutation for the addressed bucket of any entity type."
    },
    {
      "machine": "move",
      "semantic": "Queue a compatible move mutation between buckets."
    },
    {
      "machine": "data",
      "semantic": "Load and render committed data from the addressed bucket."
    },
    {
      "machine": "names",
      "semantic": "List committed row names or keys from the addressed bucket."
    },
    {
      "machine": "view",
      "semantic": "Resolve and render one committed entity row."
    },
    {
      "machine": "push",
      "semantic": "Commit pending mutations atomically, process generated state, and refresh."
    }
  ],
  "trello_policy": {
    "first_class": true,
    "entity_type": "trello",
    "path": "entities/trello/{{ board }}.json",
    "board_id_policy": "Preserve exact external IDs; never synthesize IDs.",
    "sync": "Populate a placeholder board only after connecting it to an external board.",
    "reads": "Trello reads use committed Dru JSON only."
  },
  "policies": {
    "activation": "Only the hydrated repository named by the user is active; never mix repositories or commits.",
    "empty_template": "All registered buckets begin with zero rows or values.",
    "implicit_add": "When an input starts with a registered bucket name and its next token is not a recognized command, interpret the input according to that bucket type: Pal uses add <name> <value>, Mate appends <value> to the named key, Cluster uses <name> <intensity> <value> and appends an object to that name's value array, and Trello resolves the board-specific command namespace.",
    "row_names": "Preserve human-readable UTF-8 names and encode path-dangerous characters deterministically.",
    "mutation_processing": "Reject malformed mutations, zero-match updates/removes, unknown destinations, and destination name collisions without purging the queue.",
    "official_plugin": "Dru is not an official ChatGPT plugin and must not require or claim plugin installation.",
    "mutation_selector": "Canonical selectors for update, remove, and move contain field and regex."
  },
  "entity_types": {
    "pal": {
      "description": "A general-purpose JSON bucket.",
      "concrete": true,
      "new": "Pal new <bucket>"
    },
    "mate": {
      "description": "An append-only key/value JSON bucket.",
      "concrete": true,
      "new": "Mate new <bucket>"
    },
    "cluster": {
      "description": "A name-keyed JSON-object log bucket.",
      "concrete": true,
      "new": "Cluster new <bucket>"
    },
    "hoard": {
      "description": "An aggregate bucket containing one JSON array of strings.",
      "concrete": true,
      "new": "Hoard new <bucket>",
      "storage": "string_array"
    },
    "medic": {
      "description": "A medical-domain row-oriented JSON bucket.",
      "concrete": true,
      "new": "Medic new <bucket>"
    },
    "mind": {
      "description": "A cognition, psychology, knowledge, and ideas-domain row-oriented JSON bucket.",
      "concrete": true,
      "new": "Mind new <bucket>"
    },
    "heart": {
      "description": "An emotion, attachment, desire, dream, and regret-domain row-oriented JSON bucket.",
      "concrete": true,
      "new": "Heart new <bucket>"
    },
    "spirit": {
      "description": "A spiritual, religious, faith, belief, practice, and meaning-domain row-oriented JSON bucket.",
      "concrete": true,
      "new": "Spirit new <bucket>"
    },
    "trello": {
      "description": "A synchronized Trello board entity.",
      "concrete": true,
      "new": "Trello new <board>"
    }
  },
